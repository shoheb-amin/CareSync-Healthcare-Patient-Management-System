{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "http://34.131.79.207:4004/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://34.131.79.207:4004/api/:path*"
    },
    {
      "source": "/((?!auth/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
